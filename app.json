{
  "expo": {
    "name": "EarnForRetirement",
    "slug": "earnforretirement",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "earnforretirement",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#232B38",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rnrobots.EarnForRetirement",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "EarnForRetirement needs your location to find the closest recycling drop-off centers near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 350,
          "resizeMode": "contain",
          "backgroundColor": "#232B38",
          "dark": {
            "backgroundColor": "#232B38"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EarnForRetirement needs access to your photo library so you can upload photos of recyclable materials.",
          "cameraPermission": "EarnForRetirement needs camera access so you can take photos of your recyclable materials for AI identification.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b3d5319-ffc3-44a6-92b4-b1acdefbb0c8"
      }
    },
    "owner": "rnrobots",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8b3d5319-ffc3-44a6-92b4-b1acdefbb0c8"
    }
  }
}
