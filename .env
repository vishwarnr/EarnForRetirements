# ─────────────────────────────────────────────────────────────
# .env — EarnForRetirement Environment Variables
#
# EXPO_PUBLIC_ prefix makes variables available in the client bundle.
# Do NOT commit real API keys to version control.
# ─────────────────────────────────────────────────────────────

# ── Backend REST API ──────────────────────────────────────────
# Base URL for the RnR backend (auth, user management, etc.)
EXPO_PUBLIC_API_BASE_URL=https://rnproducts.site/test-greenbless-web/api



# ── Nearby locations ──────────────────────────────────────────
# false = local mock facilities (default until locations are seeded).
# true  = POST /foodbank/nearby-locations on EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_USE_BACKEND_LOCATIONS=false
  
# Base URL for the FastAPI Data Capture pipeline
EXPO_PUBLIC_DATA_CAPTURE_URL=https://rnrrobots.site/test-fastapi

# The specific endpoint for document uploads
EXPO_PUBLIC_DATA_CAPTURE_UPLOAD_URL=https://rnrrobots.site/test-fastapi/upload-pdf-new
